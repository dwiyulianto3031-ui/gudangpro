# ============================================
# GudangPro - Environment Variables (Supabase)
# ============================================
# Copy file ini menjadi .env untuk development lokal,
# atau isi di Vercel dashboard (Settings > Environment Variables)

# --- Wajib ---
# Connection string Supabase (lihat DEPLOYMENT.md langkah 1)
# Format User: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Format Pooler: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Secret untuk JWT session (WAJIB diganti dengan string acak panjang!)
# Generate: openssl rand -base64 32
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# --- Opsional (untuk email notification, belum aktif) ---
# RESEND_API_KEY=
# EMAIL_FROM=notifikasi@gudangpro.com
